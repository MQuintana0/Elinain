{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "maxWorkers": 1,
  "testRegex": "test/(unit|integracion|e2e)/.*spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "test/tsconfig.json" }]
  },
  "transformIgnorePatterns": ["node_modules/(?!(\\.pnpm/[^/]*@scalar\\+[^/]*/|@scalar/))"]
}
