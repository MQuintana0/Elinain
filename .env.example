# Ejemplo de variables de entorno (sin valores reales; jamás commitear secretos).
# URL pooled de Neon para el runtime, con ?sslmode=require.
DATABASE_URL=
# URL directa de Neon (sin -pooler), solo para migraciones de Drizzle.
DIRECT_URL=
# Puerto HTTP (Render lo inyecta; en local por defecto 3000).
PORT=
# Entorno de ejecución (development | production).
NODE_ENV=
