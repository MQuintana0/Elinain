# Ejemplo de variables de entorno (sin valores reales; jamás commitear secretos).
# URL del rol runtime NOSUPERUSER/NOBYPASSRLS, con ?sslmode=require.
DATABASE_URL=
# URL directa del rol admin/migraciones, solo para migraciones de Drizzle.
DATABASE_MIGRATION_URL=
# URL admin opcional para pruebas de aislamiento y limpieza de fixtures.
DATABASE_ADMIN_URL=
# Puerto HTTP (Render lo inyecta; en local por defecto 3000).
PORT=
# Entorno de ejecución (development | production).
NODE_ENV=
